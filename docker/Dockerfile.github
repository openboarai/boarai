# syntax=docker/dockerfile:1

# BoarAI — GITHUB (git channel) image.
#
#   BOARAI_GIT_REPO=https://github.com/<org>/boarai.git \
#     docker compose -f docker-compose.yml -f docker-compose.github.yml up -d --build
#   optional ref:  BOARAI_GIT_REF=v1.2.0   (default: main)
#
# The image runs FROM A GIT CHECKOUT at /opt/boarai (`.git` and the `origin`
# remote kept): the steward therefore detects the git channel, whose in-place
# update is `git fetch --tags` + `git checkout <tag>` on a clean, writable
# tree with git on PATH — all four preconditions are provisioned here, so the
# container can self-update through its own channel.

# ------------------------------------------------------------------ clone ----
FROM python:3.12-slim AS clone

ARG BOARAI_GIT_REPO=
ARG BOARAI_GIT_REF=main

RUN test -n "$BOARAI_GIT_REPO" \
 || { echo "ERROR: BOARAI_GIT_REPO is required (pass --build-arg or set it for compose)"; exit 1; }

RUN apt-get update \
 && apt-get install -y --no-install-recommends git \
 && rm -rf /var/lib/apt/lists/*

RUN git clone --origin origin "$BOARAI_GIT_REPO" /opt/boarai \
 && git -C /opt/boarai checkout "$BOARAI_GIT_REF"

# ------------------------------------------------------------------ final ----
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    BOARAI_DATA_DIR=/data \
    TIKTOKEN_CACHE_DIR=/opt/boarai-tiktoken

# git is part of this channel's runtime: the update worker shells out to it.
RUN apt-get update \
 && apt-get install -y --no-install-recommends git \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --create-home --shell /usr/sbin/nologin boarai \
 && mkdir -p /data /opt/boarai-tiktoken \
 && chown -R boarai:boarai /data /opt/boarai-tiktoken

COPY --from=clone /opt/boarai /opt/boarai
WORKDIR /opt/boarai

RUN pip install --no-cache-dir -r requirements.txt \
 && chown -R boarai:boarai /opt/boarai

USER boarai

# Bake the cl100k_base encoding into the image; a failed warm-up is not fatal
# (the kernel falls back to a char-based estimate).
RUN python -c "import tiktoken; tiktoken.get_encoding('cl100k_base')" || true

EXPOSE 26620

# Public endpoint, needs no credential: proves the HTTP edge is serving.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request as u; u.urlopen('http://127.0.0.1:26620/api/auth/status', timeout=4)"

# git/source-channel launch shape (update/steward.server_launch_prefix).
CMD ["python", "main.py"]
